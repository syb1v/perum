{
  "name": "perum",
  "private": true,
  "workspaces": [
    "perum-web",
    "perum-mobile",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dompurify": "3.4.15",
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.0",
    "fast-uri": "4.2.1",
    "js-yaml": "4.2.0",
    "nanoid": "3.3.18",
    "sharp": "0.35.4",
    "webpack": {
      "browserslist": "4.29.0"
    },
    "@babel/helper-compilation-targets": {
      "browserslist": "4.29.0"
    },
    "ajv": {
      "fast-uri": "4.2.1"
    },
    "image-size": "2.0.4",
    "fflate": "0.8.3",
    "@humanfs/node": "0.17.0",
    "postcss": "8.5.28",
    "next": {
      "postcss": "8.5.25"
    }
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:shared": "npm test --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspace perum-web",
    "build:web": "npm run build --workspace perum-web",
    "contracts:generate": "npm run contracts:generate --workspace @perum/api-schema",
    "contracts:check": "npm run contracts:check --workspace @perum/api-schema",
    "audit:ci": "node scripts/audit-ci.mjs"
  },
  "devDependencies": {
    "@redocly/openapi-core": "1.34.17",
    "@xmldom/xmldom": "^0.8.13",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.15",
    "postcss": "8.5.28"
  }
}
