# PERUM — продакшн .env (скопировать в deploy/.env.prod, не коммитить).
# Деплой по docs/RUNBOOK.md. Образы — из GHCR (публикуются release-workflow по тегу).

ENVIRONMENT=prod

# Базовые образы (postgres/redis/caddy). В РФ — зеркало.
IMAGE_REGISTRY=mirror.gcr.io

# Образы приложений (из GHCR; <owner> = github.repository_owner).
# CORE_RUNTIME_IMAGE/WEB_RUNTIME_IMAGE не хранить: deploy передаёт local image IDs
# только текущему Compose invocation, а portable refs остаются пригодны для нод.
CORE_IMAGE=ghcr.io/syb1v/perum-core:git-<sha12>
AGENT_IMAGE=ghcr.io/syb1v/perum-core:git-<sha12>
WEB_IMAGE=ghcr.io/syb1v/perum-web:git-<sha12>
# TENANT_IMAGE = образ школьного стека; должен совпадать с текущим релизом в ядре.
# Use an immutable git tag or digest from the release workflow.
TENANT_IMAGE=ghcr.io/syb1v/perum-tenant:git-<sha12>

# Образы обновляются deploy-core.sh только по явно указанным immutable refs.
CORE_PULL_POLICY=missing
WEB_PULL_POLICY=missing

# Секреты — СГЕНЕРИРОВАТЬ (openssl rand -hex 32). НЕ использовать dev-значения.
SECRET_KEY=__CHANGE_ME__
CONTROL_DB_PASSWORD=__CHANGE_ME__

# Шифрование секретов школ/орг at-rest (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ВАЖНО: не менять после провижининга (иначе секреты не расшифруются).
SECRETS_ENCRYPTION_KEY=__CHANGE_ME__

# Токен для /metrics (Prometheus передаёт как Bearer). Пусто → /metrics открыт.
METRICS_TOKEN=__CHANGE_ME__

# Первый platform_admin — задать надёжный пароль (НЕ admin/admin).
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=__CHANGE_ME__

# Домены и TLS.
PUBLIC_BASE_DOMAIN=xn--l1afdm2c.xn--p1ai
ACME_EMAIL=ops@xn--l1afdm2c.xn--p1ai
CONTROL_PLANE_URL=http://perum_core:3000

# Observability (Grafana).
GRAFANA_USER=admin
GRAFANA_PASSWORD=__CHANGE_ME__

# Cloudflare DNS API — авто-управление A-записями школ.
# Токен с правами Zone:DNS:Edit (создать в CF Dashboard → Manage API Tokens).
CLOUDFLARE_API_TOKEN=__CHANGE_ME__
CLOUDFLARE_DNS_ENABLED=true

# Node-local scanner foundation. Keep disabled until the EICAR/network pilot and UI gate pass.
# Images are mandatory immutable digests, never mutable tags. The node requires >= 8 GiB RAM.
SCANNER_NODE_ENABLED=false
SCANNER_CLAMD_IMAGE=registry.example/clamd@sha256:__64_HEX_DIGEST__
SCANNER_RELAY_IMAGE=registry.example/scanner-relay@sha256:__64_HEX_DIGEST__
SCANNER_CLAMD_MEMORY=3g
SCANNER_CLAMD_CPUS=2.0
SCANNER_RELAY_MEMORY=128m
SCANNER_RELAY_CPUS=0.25
