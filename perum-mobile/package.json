{
  "name": "perum-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@perum/api-client": "*",
    "@perum/api-schema": "*",
    "@perum/design-tokens": "*",
    "@perum/domain": "*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.0",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.0",
    "expo-notifications": "~57.0.5",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "validate:config": "expo config --type public",
    "export:android": "expo export --platform android --output-dir .expo/export/android",
    "export:ios": "expo export --platform ios --output-dir .expo/export/ios"
  },
  "private": true
}
